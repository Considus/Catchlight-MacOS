    "A conflict waiting for it couldn't be opened, so it stays as it is and isn't synced. Report it so it can be looked at." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En konflikt, der venter på den, kunne ikke åbnes, så den forbliver uændret og synkroniseres ikke. Rapportér det, så det kan blive undersøgt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein dazugehöriger Konflikt konnte nicht geöffnet werden. Deshalb bleibt alles, wie es ist, und wird nicht synchronisiert. Melde es, damit es geprüft werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo abrir un conflicto pendiente, así que se queda como está y no se sincroniza. Infórmalo para que se pueda revisar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sitä odottavaa ristiriitaa ei voitu avata, joten se pysyy ennallaan eikä synkronoidu. Ilmoita siitä, jotta asia voidaan tutkia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un conflit en attente n’a pas pu être ouvert : l’élément reste tel quel et n’est pas synchronisé. Signalez-le pour qu’il puisse être examiné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è stato possibile aprire un conflitto in sospeso, quindi l’elemento resta così com’è e non viene sincronizzato. Segnalalo perché possa essere esaminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
