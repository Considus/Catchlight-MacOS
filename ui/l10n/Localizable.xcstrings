    "Your thoughts, in your order, telling your story. Nobody else's." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine tanker, i den rækkefølge du vælger, fortæller din historie. Ingen andres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gedanken, in deiner Reihenfolge, erzählen deine Geschichte. Nicht die von jemand anderem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus pensamientos, en el orden que tú elijas, para contar tu historia. La de nadie más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajatuksesi, sinun järjestyksessäsi, kertomassa sinun tarinaasi. Ei kenenkään muun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos pensées, dans l’ordre que vous leur donnez, pour raconter votre histoire. Pas celle de quelqu’un d’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi pensieri, nel tuo ordine, per raccontare la tua storia. E quella di nessun altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの順番で綴られる、あなたの物語。ほかの誰のものでもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만의 순서대로 생각을 담아 나의 이야기를 전하세요. 다른 누구의 이야기도 아닌."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tankene dine, i den rekkefølgen du velger, forteller historien din. Ingen andres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw gedachten, in jouw volgorde, vertellen jouw verhaal. Niet dat van iemand anders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje myśli, w Twojej kolejności, opowiadające Twoją historię. Nikogo innego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus pensamentos, na sua ordem, contando a sua história. A de mais ninguém."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus pensamentos, pela ordem que escolheu, a contar a sua história. Não a de mais ninguém."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina tankar, i din ordning, som berättar din historia. Ingen annans."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความคิดของคุณ เรียงตามลำดับของคุณ บอกเล่าเรื่องราวของคุณ ไม่ใช่ของใครอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşünceleriniz, sizin sıranızla, sizin hikayenizi anlatır. Başkasınınkini değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的想法，按照你的顺序，讲述你的故事。只属于你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的想法，依照你的順序，述說你的故事。只屬於你。"
          }
        }
      }
    },
