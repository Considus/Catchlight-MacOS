    "Catchlight never sees your files. Only you can read them." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight får aldrig adgang til dine filer. Kun du kan læse dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight sieht deine Dateien nie. Nur du kannst sie lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight nunca ve tus archivos. Solo tú puedes leerlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight ei koskaan näe tiedostojasi. Vain sinä voit lukea niitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight ne voit jamais vos fichiers. Seul vous pouvez les lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight non vede mai i tuoi file. Solo tu puoi leggerli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlightがあなたのファイルを見ることはありません。読めるのはあなただけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight는 사용자의 파일을 열람하지 않습니다. 본인만 읽을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight får aldri tilgang til filene dine. Bare du kan lese dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight kan je bestanden nooit zien. Alleen jij kunt ze lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight nigdy nie widzi Twoich plików. Tylko Ty możesz je odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight nunca acessa seus arquivos. Somente você pode lê-los."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight nunca vê os seus ficheiros. Apenas você os pode ler."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight ser aldrig dina filer. Bara du kan läsa dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight ไม่เคยเข้าถึงไฟล์ของคุณ มีเพียงคุณเท่านั้นที่อ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight dosyalarınızı asla görmez. Onları yalnızca siz okuyabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight 无法查看您的文件，只有您能读取它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight 絕不會讀取您的檔案。只有您能讀取這些檔案。"
          }
        }
      }
    },
    "Catchlight stores the Privacy phrase only on the device where you set it up. If you onboarded on a different device, use that one to view it." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight gemmer kun privatlivsfrasen på den enhed, hvor du konfigurerede den. Hvis du konfigurerede den på en anden enhed, skal du bruge den enhed for at se frasen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight speichert die Datenschutz-Phrase nur auf dem Gerät, auf dem du sie eingerichtet hast. Wenn du die Einrichtung auf einem anderen Gerät durchgeführt hast, verwende dieses, um sie anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight almacena la frase de privacidad únicamente en el dispositivo donde la configuraste. Si realizaste la configuración inicial en otro dispositivo, usa ese para verla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight tallentaa yksityisyyslauseen vain laitteeseen, jolla otit sen käyttöön. Jos määritit tilisi toisella laitteella, näet lauseen käyttämällä sitä laitetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight stocke la phrase de confidentialité uniquement sur l’appareil où vous l’avez configurée. Si vous avez commencé sur un autre appareil, utilisez celui-ci pour la consulter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight memorizza la frase di riservatezza solo sul dispositivo in cui è stata configurata. Se hai completato la configurazione iniziale su un altro dispositivo, usa quello per visualizzarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlightはプライバシーフレーズを、設定したデバイスにのみ保存します。別のデバイスで初期設定した場合は、そのデバイスで表示してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight는 개인정보 보호 구문을 설정한 기기에만 저장합니다. 다른 기기에서 시작했다면 해당 기기를 사용하여 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight lagrer personvernfrasen bare på enheten du konfigurerte den på. Hvis du konfigurerte appen på en annen enhet, bruker du den enheten for å vise frasen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight bewaart de privacyzin alleen op het apparaat waarop je die hebt ingesteld. Als je Catchlight op een ander apparaat voor het eerst hebt ingesteld, gebruik dan dat apparaat om de zin te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight przechowuje frazę Prywatności tylko na urządzeniu, na którym ją ustawiłeś. Jeśli rejestrowałeś się na innym urządzeniu, użyj go, aby ją zobaczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight armazena a frase de Privacidade apenas no dispositivo onde você a configurou. Se você fez o onboarding em outro dispositivo, use-o para visualizá-la."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Catchlight guarda a frase de privacidade apenas no dispositivo onde a configurou. Se iniciou a configuração noutro dispositivo, utilize esse para a visualizar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight lagrar integritetsfrasen endast på enheten där du konfigurerade den. Om du konfigurerade appen på en annan enhet kan du visa frasen där."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight จะจัดเก็บวลีความเป็นส่วนตัวไว้เฉพาะบนอุปกรณ์ที่คุณตั้งค่าไว้เท่านั้น หากคุณเริ่มใช้งานบนอุปกรณ์อื่น ให้ใช้อุปกรณ์นั้นเพื่อดู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight, Gizlilik ifadesini yalnızca kurulumu yaptığınız cihazda saklar. Başka bir cihazda başlangıç yaptıysanız ifadeyi görüntülemek için o cihazı kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight 仅会将隐私短语保存在您设置它的设备上。如果您是在另一台设备上完成初始设置，请使用那台设备查看短语。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catchlight 只會將隱私密語儲存在您設定帳戶的裝置上。如果您是在另一部裝置上完成初始設定，請使用該裝置查看密語。"
          }
        }
      }
    },
