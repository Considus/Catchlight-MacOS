    "Select an empty folder, or create a new one, and we'll take care of the rest." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en tom mappe, eller opret en ny, så tager vi os af resten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen leeren Ordner aus oder erstelle einen neuen. Um den Rest kümmern wir uns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona una carpeta vacía o crea una nueva, y nos encargaremos del resto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse tyhjä kansio tai luo uusi, niin hoidamme loput."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un dossier vide ou créez-en un nouveau, et nous nous occupons du reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona una cartella vuota o creane una nuova: al resto pensiamo noi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空のフォルダを選択するか、新しいフォルダを作成してください。あとはお任せください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비어 있는 폴더를 선택하거나 새 폴더를 만들면 나머지는 저희가 처리합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en tom mappe, eller opprett en ny, så ordner vi resten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer een lege map of maak een nieuwe map aan; de rest regelen wij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz pusty folder lub utwórz nowy, a my zajmiemy się resztą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione uma pasta vazia ou crie uma nova, e nós cuidaremos do resto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
