    "Silent. Keeps the place on the Take, with no alert when you arrive or leave." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stille. Beholder stedet på Take uden alarm ved ankomst eller afgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautlos. Speichert den Ort im Take, ohne dich bei Ankunft oder Verlassen zu benachrichtigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En silencio. Mantiene la ubicación en el Take, sin alerta al llegar o salir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänetön. Säilyttää paikan Take:ssa, mutta ei ilmoita saapuessasi tai lähtiessäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silencieux. Conserve l'emplacement du Take, sans alerte à l’arrivée ou au départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silenzioso. Mantiene il luogo associato al Take, senza avvisi quando arrivi o te ne vai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知なし。到着時や出発時に通知せず、Takeに場所を記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무음. 도착하거나 떠날 때 알림을 보내지 않고 Take에 장소를 저장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stille. Beholder stedet på Take-en, uten varsling når du kommer eller drar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stil. Bewaart de locatie in de Take, zonder melding wanneer je aankomt of vertrekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez dźwięku. Zachowuje miejsce w Take, bez alertu, gdy przybywasz lub wychodzisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silencioso. Mantém o local no Take, sem alerta ao chegar ou sair."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silencioso. Mantém o local no Take, sem alertas ao chegar ou ao sair."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyst. Sparar platsen i Taken utan avisering när du anländer eller lämnar platsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบบเงียบ จะบันทึกสถานที่ไว้ใน Take โดยไม่มีการแจ้งเตือนเมื่อคุณไปถึงหรือออกเดินทาง"
