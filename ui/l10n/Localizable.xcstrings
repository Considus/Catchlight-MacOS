          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속하기 전에 한 가지 확인할 사항이 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én ting før vi fortsetter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén ding voordat we verdergaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna rzecz, zanim przejdziemy dalej."
