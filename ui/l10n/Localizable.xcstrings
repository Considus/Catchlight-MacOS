          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกโฟลเดอร์ว่าง หรือสร้างโฟลเดอร์ใหม่ แล้วเราจะจัดการส่วนที่เหลือให้เอง"
