    "Your Obie changed on another device too. Choose which version of it to keep before you make another Take your Obie." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Din Obie blev også ændret på en anden enhed. Vælg, hvilken version af den du vil beholde, før du gør en anden Take til din Obie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Obie wurde auch auf einem anderen Gerät geändert. Wähle aus, welche Version du behalten möchtest, bevor du einen anderen Take zu deinem Obie machst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu Obie también cambió en otro dispositivo. Elige qué versión quieres conservar antes de convertir otro Take en tu Obie."
