    "Export Takes now. This is the only way to preserve them. This will make cloud copies unreadable." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportér Takes nu. Dette er den eneste måde at bevare dem på. Dette vil gøre kopier i skyen ulæselige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere Takes jetzt. Das ist die einzige Möglichkeit, sie zu bewahren. Dadurch werden Cloud-Kopien unlesbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta los Takes ahora. Esta es la única forma de conservarlos. Esto hará que las copias en la nube queden ilegibles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vie Taket nyt. Tämä on ainoa tapa säilyttää ne. Tämä tekee pilvessä olevista kopioista lukukelvottomia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez vos Takes maintenant. C’est le seul moyen de les conserver. Cela rendra les copies cloud illisibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta i Take ora. È l'unico modo per conservarli. Questo renderà illeggibili le copie nel cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐTakeを書き出してください。Takeを残すにはこれしか方法がありません。この操作により、クラウド上のコピーは読めなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 Take를 내보내세요. 보존할 수 있는 유일한 방법입니다. 이렇게 하면 클라우드 사본을 읽을 수 없게 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter Take-ene nå. Dette er den eneste måten å ta vare på dem på. Da blir kopiene i skyen uleselige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteer je Takes nu. Dit is de enige manier om ze te bewaren. Hierdoor worden cloudkopieën onleesbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyeksportuj Takes teraz. To jedyny sposób, aby je zachować. Kopie w chmurze staną się nieczytelne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte seus Takes agora. Essa é a única forma de preservá-los. Isso tornará as cópias na nuvem ilegíveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte os Takes agora. Esta é a única forma de os preservar. Isto tornará as cópias na nuvem ilegíveis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportera Takes nu. Det här är enda sättet att bevara dem. Molnkopiorna blir oläsbara."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งออก Take ตอนนี้ นี่เป็นวิธีเดียวในการเก็บรักษาไว้ การทำเช่นนี้จะทำให้สำเนาบนคลาวด์ไม่สามารถอ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take'leri şimdi dışa aktarın. Onları korumanın tek yolu budur. Bu işlem bulut kopyalarını okunamaz hale getirecektir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即导出 Takes。这是保留它们的唯一方法。此操作会使云端副本无法读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即匯出 Takes。這是保留它們的唯一方式。這麼做會使雲端副本無法讀取。"
          }
        }
      }
    },
