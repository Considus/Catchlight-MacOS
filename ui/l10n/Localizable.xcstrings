        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma coisa antes de continuarmos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sak innan vi fortsätter."
