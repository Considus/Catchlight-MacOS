            "value" : "Scriptは保存されませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Script가 저장되지 않았습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et Script ble ikke lagret"
          }
        },
        "nl" : {
          "stringUnit" : {
