        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อีกเรื่องหนึ่งก่อนที่เราจะดำเนินการต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
