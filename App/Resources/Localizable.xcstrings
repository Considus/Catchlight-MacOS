    "Sync paused. Your cloud data looks unexpected. No changes were made locally." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering sat på pause. Dine skydedata ser uventede ud. Der er ikke foretaget ændringer lokalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierung pausiert. Deine Cloud-Daten sehen unerwartet aus. Auf diesem Gerät wurden keine Änderungen vorgenommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronización pausada. Los datos de la nube no son los esperados. No se realizaron cambios localmente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronointi keskeytetty. Pilvidatassasi on jotain odottamatonta. Paikallisia muutoksia ei tehty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisation en pause. Vos données cloud semblent inattendues. Aucune modification n'a été effectuée localement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizzazione in pausa. I dati nel cloud sembrano imprevisti. Non è stata apportata alcuna modifica in locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期を一時停止しました。クラウド上のデータが想定と異なります。このデバイス上のデータは変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화가 일시 중지되었습니다. 클라우드 데이터가 예상과 다릅니다. 이 기기에서는 아무것도 변경하지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen er satt på pause. Dataene i skyen ser uventede ut. Ingen endringer er gjort lokalt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie gepauzeerd. Je cloudgegevens zien er onverwacht uit. Er zijn lokaal geen wijzigingen aangebracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja wstrzymana. Dane w chmurze wyglądają nietypowo. Nie wprowadzono żadnych zmian lokalnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronização pausada. Seus dados na nuvem parecem incomuns. Nenhuma alteração foi feita localmente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronização em pausa. Os seus dados na nuvem parecem inesperados. Nenhuma alteração foi feita localmente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen har pausats. Dina molndata verkar oväntade. Inga ändringar gjordes lokalt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซิงค์ถูกหยุดชั่วคราว ข้อมูลบนคลาวด์ดูผิดปกติ ไม่มีการเปลี่ยนแปลงในเครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşitleme duraklatıldı. Bulut verileriniz beklenmedik görünüyor. Yerel olarak hiçbir değişiklik yapılmadı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已暂停。云端数据似乎异常。本地未做任何更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已暫停。雲端資料看起來不太對勁。尚未在本機進行任何變更。"
          }
        }
      }
