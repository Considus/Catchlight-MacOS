    "Your Takes stay encrypted until you unlock them with Touch ID or your Mac's password." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dine Takes forbliver krypterede, indtil du låser dem op med Touch ID eller din Macs adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Takes bleiben verschlüsselt, bis du sie mit Touch ID oder dem Passwort deines Macs entsperrst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus Takes permanecen cifrados hasta que los desbloqueas con Touch ID o con la contraseña de tu Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Takesi pysyvät salattuina, kunnes avaat niiden lukituksen Touch ID:llä tai Macin salasanalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vos Takes restent chiffrés jusqu’à ce que vous les déverrouilliez avec Touch ID ou le mot de passe de votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I tuoi Take restano crittografati finché non li sblocchi con Touch ID o con la password del Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch IDまたはMacのパスワードでロックを解除するまで、Takeは暗号化されたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touch ID 또는 Mac 암호로 잠금 해제할 때까지 Take는 암호화된 상태로 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Take-ene dine forblir kryptert til du låser dem opp med Touch ID eller passordet til Macen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je Takes blijven versleuteld totdat je ze ontgrendelt met Touch ID of het wachtwoord van je Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje Takes pozostają zaszyfrowane, dopóki nie odblokujesz ich za pomocą Touch ID lub hasła Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seus Takes permanecem criptografados até que você os desbloqueie com o Touch ID ou a senha do seu Mac."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os seus Takes permanecem encriptados até os desbloquear com o Touch ID ou com a palavra-passe do Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dina Takes förblir krypterade tills du låser upp dem med Touch ID eller Macens lösenord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Take ของคุณจะยังคงเข้ารหัสอยู่จนกว่าคุณจะปลดล็อกด้วย Touch ID หรือรหัสผ่าน Mac ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Take'leriniz, Touch ID veya Mac'inizin parolasıyla kilidini açana kadar şifreli kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在你使用 Touch ID 或 Mac 的密码解锁之前，你的 Takes 会一直保持加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在你使用 Touch ID 或 Mac 密碼解鎖前，你的 Takes 會一直保持加密。"
          }
        }
      }
    },
