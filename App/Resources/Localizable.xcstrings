    "Choose a folder in iCloud Drive, Dropbox or any cloud you use. Catchlight keeps only encrypted files there." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg en mappe i iCloud Drive, Dropbox eller en anden cloud, du bruger. Catchlight gemmer kun krypterede filer der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle einen Ordner in iCloud Drive, Dropbox oder einer anderen Cloud, die du nutzt. Catchlight speichert dort nur verschlüsselte Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige una carpeta en iCloud Drive, Dropbox o cualquier nube que uses. Catchlight solo guarda allí archivos cifrados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse kansio iCloud Drivesta, Dropboxista tai mistä tahansa käyttämästäsi pilvipalvelusta. Catchlight säilyttää siellä vain salattuja tiedostoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez un dossier dans iCloud Drive, Dropbox ou tout autre cloud que vous utilisez. Catchlight n’y conserve que des fichiers chiffrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli una cartella in iCloud Drive, Dropbox o qualsiasi cloud che usi. Catchlight vi conserva solo file crittografati."
          }
