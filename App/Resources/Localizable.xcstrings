{
  "sourceLanguage" : "en",
  "strings" : {
    "Another device is syncing. Catchlight will retry automatically." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden enhed synkroniserer. Catchlight prøver igen automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Gerät synchronisiert gerade. Catchlight versucht es automatisch erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro dispositivo se está sincronizando. Catchlight lo reintentará automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen laite synkronoi. Catchlight yrittää uudelleen automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre appareil est en cours de synchronisation. Catchlight réessayera automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro dispositivo si sta sincronizzando. Catchlight riproverà automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスが同期中です。Catchlightは自動的に再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에서 동기화 중입니다. Catchlight가 자동으로 다시 시도합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen enhet synkroniserer. Catchlight prøver på nytt automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ander apparaat synchroniseert. Catchlight probeert het automatisch opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne urządzenie synchronizuje się. Catchlight spróbuje ponownie automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro dispositivo está sincronizando. O Catchlight tentará novamente automaticamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro dispositivo está a sincronizar. O Catchlight tentará novamente de forma automática."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan enhet synkar. Catchlight försöker igen automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์อื่นกำลังซิงค์อยู่ Catchlight จะลองใหม่อีกครั้งโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir cihaz eşitleniyor. Catchlight otomatik olarak tekrar deneyecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台设备正在同步。Catchlight 将自动重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一部裝置正在同步。Catchlight 會自動重試。"
          }
        }
      }
    },
    "Catchlight could not start its web view safely. Please quit and reopen it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight kunne ikke starte sin webvisning sikkert. Afslut, og åbn appen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight konnte seine Webansicht nicht sicher starten. Bitte beende Catchlight und öffne es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight no pudo iniciar su vista web de forma segura. Sal de Catchlight y vuelve a abrirlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight ei voinut käynnistää verkkonäkymäänsä turvallisesti. Lopeta ja avaa se uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight n’a pas pu démarrer sa vue web en toute sécurité. Veuillez quitter Catchlight et le rouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight non è riuscito ad avviare la sua vista web in modo sicuro. Esci e riapri Catchlight."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "CatchlightはWebビューを安全に起動できませんでした。終了してから、もう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight가 웹 보기를 안전하게 시작할 수 없습니다. 종료한 다음 다시 열어 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight kunne ikke starte nettvisningen sin på en trygg måte. Avslutt og åpne appen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight kon de webweergave niet veilig starten. Stop Catchlight en open de app opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight nie mógł bezpiecznie uruchomić widoku internetowego. Zakończ i otwórz go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Catchlight não conseguiu iniciar sua visualização web com segurança. Encerre-o e abra-o novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Catchlight não conseguiu iniciar a vista web em segurança. Saia e volte a abri-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight kunde inte starta sin webbvy på ett säkert sätt. Avsluta och öppna appen igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight ไม่สามารถเริ่มมุมมองเว็บได้อย่างปลอดภัย โปรดออกแล้วเปิดใหม่อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight web görünümünü güvenli bir şekilde başlatamadı. Lütfen çıkıp yeniden açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight 无法安全地启动其网页视图。请退出并重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight 無法安全地啟動其網頁顯示區。請結束並重新開啟。"
          }
        }
      }
    },
    "Catchlight couldn't finish adding this Mac and has locked your Takes to keep them safe. Quit Catchlight, open it again, and choose I already use Catchlight with your current Privacy phrase. Your Takes will be there." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight kunne ikke gøre tilføjelsen af denne Mac færdig og har låst dine Takes for at beskytte dem. Afslut Catchlight, åbn den igen, og vælg Jeg bruger allerede Catchlight med din nuværende privatfrase. Dine Takes vil være der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight konnte das Hinzufügen dieses Macs nicht abschließen und hat deine Takes zu ihrem Schutz gesperrt. Beende Catchlight, öffne es erneut und wähle „Ich nutze Catchlight bereits“ mit deiner aktuellen Datenschutz-Phrase. Deine Takes sind dann wieder da."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight no pudo terminar de añadir este Mac y ha bloqueado tus Takes para mantenerlos a salvo. Sal de Catchlight, vuelve a abrirlo y elige Ya uso Catchlight con tu frase de privacidad actual. Tus Takes estarán ahí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight ei voinut viimeistellä tämän Macin lisäämistä ja on lukinnut Takesi niiden suojaamiseksi. Lopeta Catchlight, avaa se uudelleen ja valitse Käytän jo Catchlightia nykyisellä yksityisyyslauseellasi. Takesi ovat tallessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight n’a pas pu terminer l’ajout de ce Mac et a verrouillé vos Takes pour les protéger. Quittez Catchlight, rouvrez-le et choisissez J’utilise déjà Catchlight avec votre phrase de confidentialité actuelle. Vos Takes seront là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight non è riuscito a completare l’aggiunta di questo Mac e ha bloccato i tuoi Take per proteggerli. Esci da Catchlight, riaprilo e scegli Uso già Catchlight con la tua frase di riservatezza attuale. I tuoi Take saranno lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "CatchlightはこのMacの追加を完了できなかったため、安全のためにTakeをロックしました。Catchlightを終了してもう一度開き、現在のプライバシーフレーズで「既にCatchlightを使用しています」を選択してください。Takeはそのまま残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight가 이 Mac 추가를 완료하지 못해, 안전을 위해 Take를 잠갔습니다. Catchlight를 종료한 다음 다시 열고, 현재 개인정보 보호 문구로 '이미 Catchlight을 사용 중입니다'를 선택하세요. Take는 그대로 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight kunne ikke fullføre å legge til denne Macen og har låst Take-ene dine for å beskytte dem. Avslutt Catchlight, åpne appen igjen og velg Jeg bruker allerede Catchlight med den nåværende personvernfrasen din. Take-ene dine vil være der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight kon het toevoegen van deze Mac niet voltooien en heeft je Takes vergrendeld om ze te beschermen. Stop Catchlight, open de app opnieuw en kies Ik gebruik Catchlight al met je huidige privacyfrase. Je Takes zijn er dan gewoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight nie mógł dokończyć dodawania tego Maca i zablokował Twoje Takes, aby je chronić. Zakończ Catchlight, otwórz go ponownie i wybierz Używam już Catchlight, podając swoją obecną frazę prywatności. Twoje Takes będą na miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Catchlight não conseguiu concluir a adição deste Mac e bloqueou seus Takes para mantê-los seguros. Encerre o Catchlight, abra-o novamente e escolha Já uso o Catchlight com sua frase de Privacidade atual. Seus Takes estarão lá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Catchlight não conseguiu terminar de adicionar este Mac e bloqueou os seus Takes para os manter seguros. Saia do Catchlight, volte a abri-lo e escolha Já utilizo o Catchlight com a sua frase de privacidade atual. Os seus Takes estarão lá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight kunde inte slutföra tillägget av den här Macen och har låst dina Takes för att skydda dem. Avsluta Catchlight, öppna appen igen och välj Jag använder redan Catchlight med din nuvarande integritetsfras. Dina Takes finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight ไม่สามารถเพิ่ม Mac เครื่องนี้ให้เสร็จสิ้นได้ และได้ล็อก Take ของคุณไว้เพื่อความปลอดภัย ออกจาก Catchlight เปิดใหม่อีกครั้ง แล้วเลือก ฉันใช้ Catchlight อยู่แล้ว พร้อมวลีความเป็นส่วนตัวปัจจุบันของคุณ Take ของคุณจะยังอยู่ครบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight bu Mac'i eklemeyi tamamlayamadı ve Take'lerinizi güvende tutmak için kilitledi. Catchlight'tan çıkın, yeniden açın ve mevcut Gizlilik ifadenizle Zaten Catchlight kullanıyorum seçeneğini seçin. Take'leriniz orada olacak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight 未能完成添加这台 Mac，并已锁定你的 Takes 以确保其安全。请退出 Catchlight 并重新打开，选择“我已经在使用 Catchlight”，然后输入你当前的隐私短语。你的 Takes 都会在。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catchlight 未能完成加入這部 Mac，並已鎖定你的 Takes 以確保安全。請結束 Catchlight 並重新開啟，選擇「我已經在使用 Catchlight」，然後輸入你目前的隱私密語。你的 Takes 都會在。"
          }
        }
      }
    },
